# systemd unit for the digitization batch. Install:
#   sudo cp deploy/evilflowers-digitalizer.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl start evilflowers-digitalizer
#   journalctl -u evilflowers-digitalizer -f          # follow logs
# Adjust WorkingDirectory / user / venv path to your install.

[Unit]
Description=EvilFlowers Books Digitalizer batch
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=digitizer
WorkingDirectory=/opt/evilflowers-books-digitalizer
# Relative paths in the config resolve against the config file's directory.
Environment=EVILFLOWERS_DIGITALIZER_CONFIG=/opt/evilflowers-books-digitalizer/configs/pipeline.vm.toml
# Environment=EVILFLOWERS_LOG_FORMAT=json
# EnvironmentFile=-/etc/evilflowers-digitalizer.env   # EVILFLOWERS_API_KEY=...
ExecStart=/opt/evilflowers-books-digitalizer/.venv/bin/evilflowers-digitalizer run-corpus
# resumable: a crash restarts and skips already-finished books; clean finish does not restart
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

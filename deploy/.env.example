# Copy to deploy/.env and adjust. Used by docker-compose.yml.

# Host paths bind-mounted into the container
RAW_SCANS_MOUNT=/mnt/digital-library/raw-scans
OUTPUT_DIR=../output
CACHE_DIR=../.cache

# uid:gid the container runs as; must be able to write OUTPUT_DIR and CACHE_DIR
# (e.g. `id -u` / `id -g` of the owner of those directories).
DIGITALIZER_UID=10001
DIGITALIZER_GID=0

# Logging: text (default) or json (one object per line on stderr, for Loki).
EVILFLOWERS_LOG_FORMAT=text
EVILFLOWERS_LOG_LEVEL=INFO

# EvilFlowers Catalog import (publish-book / publish-catalog / --publish; see
# [catalog] in configs/pipeline.toml). A long-lived API key (a Bearer JWT) for
# the catalog instance — create one via POST /api/v1/api_keys. Blank disables it.
EVILFLOWERS_API_KEY=

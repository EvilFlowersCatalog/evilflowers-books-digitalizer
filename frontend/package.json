{
  "name": "evilflowers-restoration-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Restoration Studio SPA: operator UI for the EvilFlowers books digitalizer (/api/v1).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
